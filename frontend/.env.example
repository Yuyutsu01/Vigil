# ==============================================================================
# Vigil Enterprise Frontend Environment Configuration
# ==============================================================================

# Vigil FastAPI Backend Base URL (Configurable, defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client Execution Mode:
# 'real' (Default): Enforces live REST HTTP calls. Fails visibly with error toasts on network failure.
# 'mock' (Development Only): Uses deterministic in-memory fixtures, logs [MOCK] to console,
#                            and renders a persistent warning banner. Forbidden in production builds.
NEXT_PUBLIC_API_MODE=real
