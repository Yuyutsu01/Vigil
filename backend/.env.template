"""
Backend .env template.
Copy to .env and fill in production values.
NEVER commit .env to source control.
"""
# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vigil:vigil@localhost:5432/vigil

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (CHANGE THIS BEFORE PRODUCTION) ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_USE_32_BYTES_MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic
VIGIL_LLM_PROVIDER=mock
VIGIL_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Application ────────────────────────────────────────────────────────────
VIGIL_ENV=development
VIGIL_DEBUG=false
VIGIL_CORS_ORIGINS=http://localhost:3000
VIGIL_CONSENT_POLICY_VERSION=1.0

# ── Rate Limiting ─────────────────────────────────────────────────────────
VIGIL_RATE_LIMIT_TENANT_PER_MINUTE=60
VIGIL_RATE_LIMIT_USER_PER_MINUTE=20

# ── Retention ─────────────────────────────────────────────────────────────
VIGIL_SOURCE_RETENTION_DAYS=30
VIGIL_FINDINGS_RETENTION_DAYS=90
