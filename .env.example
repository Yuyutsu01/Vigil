# ── Application Configuration ──────────────────────────────────────────────────
VIGIL_ENV=development
VIGIL_DEBUG=false
DATABASE_URL=postgresql+asyncpg://vigil:vigil@localhost:5432/vigil
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=CHANGE_ME_BEFORE_PRODUCTION_USE_32_BYTES_MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
VIGIL_CONSENT_POLICY_VERSION=1.0
VIGIL_CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
VIGIL_RATE_LIMIT_TENANT_PER_MINUTE=60
VIGIL_RATE_LIMIT_USER_PER_MINUTE=20

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM provider: mock | groq | openai | anthropic
VIGIL_LLM_PROVIDER=groq
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VIGIL_LLM_MODEL=llama-3.3-70b-versatile

# ── Retention & Limits ────────────────────────────────────────────────────────
VIGIL_SOURCE_RETENTION_DAYS=30
VIGIL_FINDINGS_RETENTION_DAYS=90
VIGIL_MAX_UPLOAD_BYTES=262144

# ── Phase 3 GitHub App Integration (FR-103, FR-104) ───────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=env://GITHUB_APP_PRIVATE_KEY
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_WEBHOOK_SECRET_PREVIOUS=
GITHUB_APP_SLUG=vigil-security
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DIFF_MAX_FILES=1000

# ── Phase 3 Aggregated Review Budget & Cost Guard ─────────────────────────────
REPO_REVIEW_MAX_LLM_CALLS=50
REPO_REVIEW_MAX_TOTAL_TOKENS=500000
REPO_REVIEW_MAX_WALL_CLOCK_SECONDS=600
REPO_REVIEW_MAX_COST_USD=5.00
REPO_REVIEW_INPUT_COST_PER_TOKEN=0.000003
REPO_REVIEW_OUTPUT_COST_PER_TOKEN=0.000015
